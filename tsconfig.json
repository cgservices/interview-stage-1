{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "jest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
